{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CIAP Ecosystem Governance",
  "type": "object",
  "required": [
    "name",
    "version",
    "governanceDomains"
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "governanceDomains": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "maturityLevel": {
      "type": "string"
    }
  }
}