{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CIAP Developer Ecosystem",
  "type": "object",
  "required": [
    "name",
    "version",
    "services"
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "services": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "certificationEnabled": {
      "type": "boolean"
    }
  }
}