{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CIAP Industry Reference",
  "type": "object",
  "required": [
    "name",
    "version",
    "industry"
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "industry": {
      "type": "string"
    },
    "profiles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}